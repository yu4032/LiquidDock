<?xml version="1.0" encoding="utf-8"?>
<!-- Destructive action uses a fixed red fill. Complex Cell highlight is
     separately baked into the Card/Pill resources, avoiding per-item shaders. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="999dp"/>
    <solid android:color="#FFD73333"/>
    <stroke android:width="1dp" android:color="#FFFF9C9C"/>
</shape>
