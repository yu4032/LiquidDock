<?xml version="1.0" encoding="utf-8"?>
<!-- Prebaked fixed GUI chrome: NO per-cell Prismal lighting, backdrop blur or refraction shader.
     Shape radius is in dp so the same resource works on every resolution and cell height. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270"
                android:startColor="#ECFFFFFF"
                android:centerColor="#DDEDF2F9"
                android:endColor="#C8E1E8F2" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="45"
                android:startColor="#AAFFFFFF"
                android:centerColor="#25FFFFFF"
                android:endColor="#18D3E0EC" />
        </shape>
    </item>
    <!-- Preserves Prismal-like rim contrast at fixed cost, without a backdrop read. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#A2FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#00000000" />
            <stroke android:width="0.5dp" android:color="#47FFFFFF" />
        </shape>
    </item>
</layer-list>
