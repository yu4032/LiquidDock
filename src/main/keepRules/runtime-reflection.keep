# Project-owned lifecycle access should normally use typed package-private APIs.
# SecurityCenterSourceAuthorityController is the one intentional exception: it resolves these
# exact private members by string name. Preserve only those names/signatures so release R8 remains
# free to shrink, inline, merge, and obfuscate the rest of LiquidDock.
-keepclassmembers class com.hellovoid.liquiddock.SecurityCenterGlassCoordinator {
    com.hellovoid.liquiddock.SecurityCenterGlassSceneState scene;
    com.hellovoid.liquiddock.SecurityCenterGlassSceneState$Target targetKind;
    com.hellovoid.liquiddock.SecurityCenterGlassFrameGeometry currentFrame;
    com.hellovoid.liquiddock.SecurityCenterGlassSession session;
    java.lang.ref.WeakReference turboRef;

    void reconcileSinks();
    boolean syncSinksFromMaterials();
    com.hellovoid.liquiddock.SecurityCenterGlassFrameGeometry captureFrame(boolean);
    void hideAndRestoreVendor();
    void prepareCustomOwnershipForPresentation();
    void requestCurrentGeneration(com.hellovoid.liquiddock.SecurityCenterGlassFrameGeometry);
}

-keepclassmembers class com.hellovoid.liquiddock.SecurityCenterGlassSession {
    com.hellovoid.liquiddock.RootPassBlurBackend sourceBackend;
}
