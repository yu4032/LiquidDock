# libxposed loads this class by the literal name stored in META-INF/xposed/java_init.list.
# Keep the entry class and its members stable; the rest of LiquidDock is free to shrink,
# inline, merge, and obfuscate normally.
-keep class com.hellovoid.liquiddock.ModuleMain { *; }

# SystemUI -> Launcher unlock timing is a framework/Xposed boundary. These classes form a
# deliberately small stable island for post-unlock Workspace recovery. HOME presentation is owned
# entirely by Launcher's native RectFSpringAnim lifecycle.
-keep class com.hellovoid.liquiddock.SystemUiKeyguardGoneSource { *; }
-keep class com.hellovoid.liquiddock.SystemUiKeyguardGonePolicy { *; }
-keep class com.hellovoid.liquiddock.SystemUiKeyguardGoneProtocol { *; }
-keep class com.hellovoid.liquiddock.SystemUiKeyguardGoneRuntime { *; }

-keep class com.hellovoid.liquiddock.LauncherGlassHomePresentationHook { *; }

# Android components referenced from the manifest are covered by AGP's default keep rules.
# Miuix/Compose code is referenced normally and should rely on dependency consumer rules;
# do not keep the whole dependency tree, otherwise R8 cannot meaningfully prune it.

# Hidden framework / vendor classes referenced by hooks.
-dontwarn com.android.internal.**
-dontwarn miui.**
