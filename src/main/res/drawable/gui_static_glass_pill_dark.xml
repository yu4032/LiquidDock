<?xml version="1.0" encoding="utf-8"?>
<!-- Prebaked fixed GUI chrome: NO per-cell Prismal lighting, backdrop blur or refraction shader.
     Shape radius is in dp so the same resource works on every resolution and cell height. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient android:angle="270"
                android:startColor="#B04D5664"
                android:centerColor="#B02B3441"
                android:endColor="#B0252C36" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient android:angle="45"
                android:startColor="#5AFFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#110A121E" />
        </shape>
    </item>
    <!-- Preserves Prismal-like rim contrast at fixed cost, without a backdrop read. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#63DFE7F4" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#00000000" />
            <stroke android:width="0.5dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
